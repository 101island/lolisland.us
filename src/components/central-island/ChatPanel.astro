---
import { getLangFromUrl, getTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<section class="group-chat">
  <header class="group-chat-header">
    <h3>{t("chat.title")}</h3>
    <span id="chat-status" class="chat-status"
      >{t("chat.status.connecting")}</span
    >
  </header>

  <ul id="chat-message-list" class="chat-message-list"></ul>

  <div id="chat-emoji-bar" class="chat-emoji-bar">
    <button
      type="button"
      class="emoji-pill"
      data-emoji-token="[[[default:smile]]]"
    >
      :smile:
    </button>
    <button
      type="button"
      class="emoji-pill"
      data-emoji-token="[[[default:heart]]]"
    >
      :heart:
    </button>
    <button
      type="button"
      class="emoji-pill"
      data-emoji-token="[[[default:ok]]]"
    >
      :ok:
    </button>
  </div>

  <div class="chat-composer">
    <textarea
      id="chat-input"
      class="chat-input"
      rows="2"
      maxlength="2000"
      placeholder={t("chat.placeholder")}
    ></textarea>
    <input id="chat-image-input" type="file" accept="image/*" class="hidden">
    <div class="chat-actions">
      <button id="chat-upload-btn" type="button" class="chat-action-btn">
        {t("chat.upload")}
      </button>
      <button
        id="chat-send-btn"
        type="button"
        class="chat-send-btn"
        data-default-text={t("chat.send")}
      >
        {t("chat.send")}
      </button>
    </div>
  </div>
</section>

<script>
  import { BACKEND_API_BASE } from "../../config/loginApiBaseUrl";

  const CHAT_LIMIT = 50;
  const CHAT_POLL_INTERVAL_MS = 3000;
  const EMOJI_TOKEN_PATTERN = /^\[\[\[([^:\]]+):([^\]]+)\]\]\]$/;

  type ChatMessage = {
    id: string;
    username: string;
    kind: "text" | "image";
    content: string;
    imageKey: string | null;
    createdMs: number;
  };

  const getLanguage = () => document.documentElement.lang || "en";

  const getText = (key: string) => {
    const table: Record<string, Record<string, string>> = {
      en: {
        connecting: "Connecting",
        online: "Online",
        offline: "Offline",
        sending: "Sending...",
        uploadFailed: "Upload failed",
        sendFailed: "Message failed",
        needLogin: "Please login first",
      },
      "zh-cn": {
        connecting: "连接中",
        online: "在线",
        offline: "离线",
        sending: "发送中...",
        uploadFailed: "上传失败",
        sendFailed: "发送失败",
        needLogin: "请先登录",
      },
      "zh-hk": {
        connecting: "連線中",
        online: "在線",
        offline: "離線",
        sending: "發送中...",
        uploadFailed: "上傳失敗",
        sendFailed: "發送失敗",
        needLogin: "請先登入",
      },
      ja: {
        connecting: "接続中",
        online: "オンライン",
        offline: "オフライン",
        sending: "送信中...",
        uploadFailed: "アップロード失敗",
        sendFailed: "送信失敗",
        needLogin: "先にログインしてください",
      },
    };

    const lang = getLanguage();
    const values = table[lang] || table.en;
    return values[key] || table.en[key] || key;
  };

  const escapeHtml = (value: string) =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const messageBodyHtml = (message: ChatMessage) => {
    if (message.kind === "image" && message.imageKey) {
      const escaped = encodeURIComponent(message.imageKey);
      return `<img class="chat-image" src="${BACKEND_API_BASE}/chat/images/${escaped}" alt="chat image" loading="lazy">`;
    }

    const match = message.content.match(EMOJI_TOKEN_PATTERN);
    if (match) {
      const pack = escapeHtml(match[1]);
      const name = escapeHtml(match[2]);
      return `<span class="emoji-tag" title="${pack}:${name}">${name}</span>`;
    }

    return `<span class="chat-text">${escapeHtml(message.content)}</span>`;
  };

  const renderMessages = (messages: ChatMessage[]) => {
    const list = document.getElementById("chat-message-list");
    if (!list) return;

    const self = localStorage.getItem("username") || "";

    list.innerHTML = messages
      .map((message) => {
        const isOwn = self && message.username === self;
        const itemClass = isOwn
          ? "chat-message-item chat-message-item-own"
          : "chat-message-item";
        return `<li class="${itemClass}" data-id="${escapeHtml(message.id)}"><div class="chat-bubble"><p class="chat-user">${escapeHtml(message.username)}</p><div class="chat-message-body">${messageBodyHtml(message)}</div></div></li>`;
      })
      .join("");

    list.scrollTop = list.scrollHeight;
  };

  const setStatus = (text: string, isOnline: boolean) => {
    const status = document.getElementById("chat-status");
    if (!status) return;
    status.textContent = text;
    status.classList.toggle("chat-status-online", isOnline);
  };

  const getAuthHeader = () => {
    const token = localStorage.getItem("token");
    if (!token) return null;
    return `Bearer ${token}`;
  };

  const readMessages = async () => {
    const res = await fetch(
      `${BACKEND_API_BASE}/chat/messages?limit=${CHAT_LIMIT}`,
      {
        cache: "no-store",
      },
    );

    if (!res.ok) throw new Error("Failed");
    const data = (await res.json()) as { messages: ChatMessage[] };
    return data.messages || [];
  };

  const postMessage = async (payload: { text?: string; imageKey?: string }) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const res = await fetch(`${BACKEND_API_BASE}/chat/messages`, {
      method: "POST",
      headers: {
        Authorization: auth,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    if (!res.ok) throw new Error(getText("sendFailed"));
  };

  const uploadImage = async (file: File) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const formData = new FormData();
    formData.append("image", file);

    const res = await fetch(`${BACKEND_API_BASE}/chat/images`, {
      method: "POST",
      headers: { Authorization: auth },
      body: formData,
    });

    if (!res.ok) throw new Error(getText("uploadFailed"));

    const data = (await res.json()) as { key: string };
    if (!data.key) throw new Error(getText("uploadFailed"));
    return data.key;
  };

  const setupChat = () => {
    const input = document.getElementById(
      "chat-input",
    ) as HTMLTextAreaElement | null;
    const sendBtn = document.getElementById(
      "chat-send-btn",
    ) as HTMLButtonElement | null;
    const uploadBtn = document.getElementById(
      "chat-upload-btn",
    ) as HTMLButtonElement | null;
    const imageInput = document.getElementById(
      "chat-image-input",
    ) as HTMLInputElement | null;

    if (!input || !sendBtn || !uploadBtn || !imageInput) return;

    if (window._chatPanelPollTimer) {
      window.clearInterval(window._chatPanelPollTimer);
      window._chatPanelPollTimer = null;
    }

    const refresh = async () => {
      try {
        const messages = await readMessages();
        renderMessages(messages);
        setStatus(getText("online"), true);
      } catch {
        setStatus(getText("offline"), false);
      }
    };

    setStatus(getText("connecting"), false);
    refresh();
    window._chatPanelPollTimer = window.setInterval(
      refresh,
      CHAT_POLL_INTERVAL_MS,
    );

    sendBtn.onclick = async () => {
      const text = input.value.trim();
      if (!text) return;

      const defaultText = sendBtn.dataset.defaultText || getText("send");
      sendBtn.disabled = true;
      sendBtn.textContent = getText("sending");

      try {
        await postMessage({ text });
        input.value = "";
        await refresh();
      } catch (error) {
        alert(error instanceof Error ? error.message : getText("sendFailed"));
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = defaultText;
      }
    };

    input.onkeydown = (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendBtn.click();
      }
    };

    uploadBtn.onclick = () => {
      imageInput.click();
    };

    imageInput.onchange = async () => {
      const file = imageInput.files?.[0];
      if (!file) return;

      uploadBtn.disabled = true;
      try {
        const imageKey = await uploadImage(file);
        await postMessage({ imageKey });
        await refresh();
      } catch (error) {
        alert(error instanceof Error ? error.message : getText("uploadFailed"));
      } finally {
        uploadBtn.disabled = false;
        imageInput.value = "";
      }
    };

    document.querySelectorAll("[data-emoji-token]").forEach((button) => {
      button.addEventListener("click", () => {
        const token = button.getAttribute("data-emoji-token");
        if (!token) return;
        input.value = token;
        input.focus();
      });
    });
  };

  document.addEventListener("astro:page-load", setupChat);
  window.addEventListener("logout-success", () => {
    if (window._chatPanelPollTimer) {
      window.clearInterval(window._chatPanelPollTimer);
      window._chatPanelPollTimer = null;
    }
  });
</script>

<style>
  .group-chat {
    height: 100%;
    border-radius: 16px;
    background: linear-gradient(
      180deg,
      rgba(16, 19, 29, 0.65),
      rgba(14, 18, 29, 0.85)
    );
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    padding: 0.75rem;
    gap: 0.6rem;
  }

  .group-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.15rem 0.25rem;
  }

  .group-chat-header h3 {
    margin: 0;
    color: rgba(244, 248, 255, 0.95);
    font-size: 1rem;
  }

  .chat-status {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .chat-status-online {
    color: #9eebb0;
  }

  .chat-message-list {
    margin: 0;
    padding: 0.2rem;
    list-style: none;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .chat-message-item {
    display: flex;
    justify-content: flex-start;
  }

  .chat-message-item-own {
    justify-content: flex-end;
  }

  .chat-bubble {
    max-width: min(72%, 560px);
    border-radius: 12px 12px 12px 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 0.45rem 0.58rem;
    text-align: left;
  }

  .chat-message-item-own .chat-bubble {
    border-radius: 12px 12px 4px 12px;
    background: rgba(114, 194, 156, 0.23);
    border-color: rgba(123, 215, 170, 0.34);
  }

  .chat-user {
    margin: 0 0 0.2rem;
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .chat-message-body {
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.93rem;
    word-break: break-word;
  }

  .chat-image {
    display: block;
    width: 100%;
    max-width: 320px;
    border-radius: 10px;
  }

  .emoji-tag {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.14);
    padding: 0.15rem 0.6rem;
    font-size: 0.8rem;
  }

  .chat-emoji-bar {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .emoji-pill {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
    font-size: 0.75rem;
  }

  .chat-composer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.55rem;
  }

  .chat-input {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.24);
    color: rgba(255, 255, 255, 0.96);
    padding: 0.55rem 0.65rem;
    min-height: 66px;
    resize: none;
  }

  .chat-actions {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .chat-action-btn,
  .chat-send-btn {
    border-radius: 10px;
    padding: 0.45rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.08);
    cursor: pointer;
    font-size: 0.85rem;
  }

  .chat-send-btn {
    background: rgba(128, 216, 174, 0.26);
    border-color: rgba(128, 216, 174, 0.42);
  }

  .chat-action-btn:disabled,
  .chat-send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 900px) {
    .group-chat {
      border-radius: 12px;
      padding: 0.55rem;
    }

    .chat-bubble {
      max-width: 86%;
    }

    .chat-composer {
      grid-template-columns: 1fr;
    }

    .chat-actions {
      flex-direction: row;
      justify-content: flex-end;
    }
  }
</style>
