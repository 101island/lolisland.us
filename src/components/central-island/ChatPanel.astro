---
import { getLangFromUrl, getTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<section class="chat-shell">
  <header class="chat-header">
    <div class="chat-header-meta">
      <h3>{t("chat.title")}</h3>
      <p class="chat-subtitle">island group</p>
    </div>
    <span id="chat-status" class="chat-status"
      >{t("chat.status.connecting")}</span
    >
  </header>

  <ul id="chat-message-list" class="chat-message-list"></ul>

  <div id="reply-box" class="reply-box hidden">
    <div class="reply-content">
      <p id="reply-author" class="reply-author"></p>
      <p id="reply-preview" class="reply-preview"></p>
    </div>
    <button id="reply-cancel-btn" class="reply-cancel-btn" type="button">
      ×
    </button>
  </div>

  <div class="composer-row">
    <textarea
      id="chat-input"
      class="chat-input"
      rows="2"
      maxlength="2000"
      placeholder={t("chat.placeholder")}
    ></textarea>

    <div class="composer-actions">
      <input id="chat-image-input" type="file" accept="image/*" class="hidden">
      <button id="chat-emoji-toggle" class="action-btn" type="button">
        😊
      </button>
      <button id="chat-upload-btn" class="action-btn" type="button">＋</button>
      <button
        id="chat-send-btn"
        class="send-btn"
        type="button"
        data-default-text={t("chat.send")}
      >
        {t("chat.send")}
      </button>
    </div>
  </div>

  <div id="chat-emoji-panel" class="emoji-panel hidden">
    <div class="emoji-grid" id="chat-emoji-grid"></div>
    <div class="qface-grid" id="chat-qface-grid"></div>
  </div>

  <div id="chat-context-menu" class="chat-context-menu hidden"></div>
</section>

<script>
  import { BACKEND_API_BASE } from "../../config/loginApiBaseUrl";

  const CHAT_LIMIT = 50;
  const SSE_RECONNECT_DELAY_MS = 2500;
  const MAX_CHAT_IMAGE_BYTES = 512 * 1024;
  const MIN_IMAGE_QUALITY = 0.42;
  const EMOJI_TOKEN_PATTERN = /^\[\[\[([^:\]]+):([^\]]+)\]\]\]$/;
  const REPLY_PREFIX_PATTERN = /^\[\[\[reply:([^\]]+)\]\]\]\n?/;
  const EMOJI_PICKER = [
    "😀",
    "😆",
    "🥰",
    "🤔",
    "😭",
    "😎",
    "😡",
    "👍",
    "🙏",
    "🎉",
    "✨",
    "🔥",
  ];
  const QFACE_PICKER = [
    "微笑",
    "撇嘴",
    "色",
    "发呆",
    "得意",
    "流泪",
    "害羞",
    "闭嘴",
    "睡",
    "大哭",
    "尴尬",
    "发怒",
    "调皮",
    "呲牙",
    "惊讶",
    "难过",
    "酷",
    "抓狂",
    "吐",
    "偷笑",
    "可爱",
    "白眼",
    "傲慢",
    "饥饿",
    "困",
    "惊恐",
    "流汗",
    "憨笑",
    "悠闲",
    "奋斗",
    "咒骂",
    "疑问",
    "嘘",
    "晕",
    "折磨",
    "衰",
  ];
  const QUICK_REACTIONS = [
    { label: "😀", value: "😀" },
    { label: "🥰", value: "🥰" },
    { label: "👍", value: "👍" },
    { label: "[微笑]", value: "[[[qface:微笑]]]" },
    { label: "[疑问]", value: "[[[qface:疑问]]]" },
  ];

  type ChatMessage = {
    id: string;
    username: string;
    kind: "text" | "image";
    content: string;
    imageKey: string | null;
    createdMs: number;
  };

  type UserAvatar = {
    name: string;
    id: string;
  };

  type MessageView = ChatMessage & {
    plainContent: string;
    replyToId: string | null;
  };

  const isNearBottom = (el: HTMLElement) =>
    el.scrollHeight - el.scrollTop - el.clientHeight < 72;

  const getLanguage = () => document.documentElement.lang || "en";

  const getText = (key: string) => {
    const table: Record<string, Record<string, string>> = {
      en: {
        connecting: "Connecting",
        online: "Online",
        offline: "Offline",
        sending: "Sending...",
        uploadFailed: "Upload failed",
        sendFailed: "Message failed",
        needLogin: "Please login first",
        replying: "Replying to",
        menuReply: "Reply",
        menuCopy: "Copy",
        menuEmoji: "Paste emoji",
        menuMoreEmoji: "More",
        menuWithdraw: "Withdraw",
        copyFailed: "Copy failed",
        withdrawFailed: "Withdraw failed",
        imageTooLarge: "Image must be smaller than 512KiB",
        imageProcessFailed: "Image processing failed",
      },
      "zh-cn": {
        connecting: "连接中",
        online: "在线",
        offline: "离线",
        sending: "发送中...",
        uploadFailed: "上传失败",
        sendFailed: "发送失败",
        needLogin: "请先登录",
        replying: "回复",
        menuReply: "回复",
        menuCopy: "复制",
        menuEmoji: "贴表情",
        menuMoreEmoji: "更多",
        menuWithdraw: "撤回",
        copyFailed: "复制失败",
        withdrawFailed: "撤回失败",
        imageTooLarge: "图片需要小于 512KiB",
        imageProcessFailed: "图片处理失败",
      },
      "zh-hk": {
        connecting: "連線中",
        online: "在線",
        offline: "離線",
        sending: "發送中...",
        uploadFailed: "上傳失敗",
        sendFailed: "發送失敗",
        needLogin: "請先登入",
        replying: "回覆",
        menuReply: "回覆",
        menuCopy: "複製",
        menuEmoji: "貼表情",
        menuMoreEmoji: "更多",
        menuWithdraw: "撤回",
        copyFailed: "複製失敗",
        withdrawFailed: "撤回失敗",
        imageTooLarge: "圖片需要小於 512KiB",
        imageProcessFailed: "圖片處理失敗",
      },
      ja: {
        connecting: "接続中",
        online: "オンライン",
        offline: "オフライン",
        sending: "送信中...",
        uploadFailed: "アップロード失敗",
        sendFailed: "送信失敗",
        needLogin: "先にログインしてください",
        replying: "返信先",
        menuReply: "返信",
        menuCopy: "コピー",
        menuEmoji: "絵文字を貼る",
        menuMoreEmoji: "もっと",
        menuWithdraw: "取り消し",
        copyFailed: "コピー失敗",
        withdrawFailed: "取り消し失敗",
        imageTooLarge: "画像は 512KiB 未満にしてください",
        imageProcessFailed: "画像処理に失敗しました",
      },
    };

    const values = table[getLanguage()] || table.en;
    return values[key] || table.en[key] || key;
  };

  const escapeHtml = (value: string) =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const previewText = (value: string) => {
    const text = value.replaceAll("\n", " ").trim();
    return text.length > 60 ? `${text.slice(0, 60)}...` : text;
  };

  const parseMessage = (message: ChatMessage): MessageView => {
    const match = message.content.match(REPLY_PREFIX_PATTERN);
    const replyToId = match?.[1] || null;
    const plainContent = match
      ? message.content.replace(REPLY_PREFIX_PATTERN, "")
      : message.content;
    return {
      ...message,
      plainContent,
      replyToId,
    };
  };

  const getAvatarByUser = (
    username: string,
    ownUsername: string,
    ownAvatar: string,
    avatarMap: Map<string, string>,
  ) => {
    if (username === ownUsername && /^[0-9a-f]{16}$/.test(ownAvatar)) {
      return `${BACKEND_API_BASE}/user/avatar/${ownAvatar}`;
    }
    const avatarId = avatarMap.get(username) || "";
    if (/^[0-9a-f]{16}$/.test(avatarId)) {
      return `${BACKEND_API_BASE}/user/avatar/${avatarId}`;
    }
    return `https://ui-avatars.com/api/?name=${encodeURIComponent(username)}&background=1f2937&color=ffffff&size=96`;
  };

  const renderContent = (message: MessageView) => {
    if (message.kind === "image" && message.imageKey) {
      const image = encodeURIComponent(message.imageKey);
      return `<img class="chat-image" src="${BACKEND_API_BASE}/chat/images/${image}" alt="chat image" loading="lazy">`;
    }

    const emojiMatch = message.plainContent.match(EMOJI_TOKEN_PATTERN);
    if (emojiMatch) {
      const pack = emojiMatch[1];
      const name = emojiMatch[2];
      const safePack = escapeHtml(pack);
      const safeName = escapeHtml(name);
      if (pack === "qface") {
        return `<span class="qface-token" title="${safePack}:${safeName}">[${safeName}]</span>`;
      }
      return `<span class="emoji-token" title="${safePack}:${safeName}">${safeName}</span>`;
    }

    return `<span>${escapeHtml(message.plainContent)}</span>`;
  };

  const setStatus = (text: string, online: boolean) => {
    const status = document.getElementById("chat-status");
    if (!status) return;
    status.textContent = text;
    status.classList.toggle("chat-status-online", online);
  };

  const fetchUsers = async () => {
    const res = await fetch(`${BACKEND_API_BASE}/users`, {
      cache: "no-store",
    });
    if (!res.ok) return new Map<string, string>();
    const users = (await res.json()) as UserAvatar[];
    return new Map<string, string>(users.map((item) => [item.name, item.id]));
  };

  const fetchMessages = async () => {
    const res = await fetch(
      `${BACKEND_API_BASE}/chat/messages?limit=${CHAT_LIMIT}`,
      {
        cache: "no-store",
      },
    );
    if (!res.ok) throw new Error("load failed");
    const data = (await res.json()) as { messages: ChatMessage[] };
    return data.messages || [];
  };

  const getAuthHeader = () => {
    const token = localStorage.getItem("token");
    return token ? `Bearer ${token}` : null;
  };

  const decodeJwtUserId = (token: string) => {
    try {
      const payloadPart = token.split(".")[1] || "";
      const normalized = payloadPart.replaceAll("-", "+").replaceAll("_", "/");
      const padded = normalized.padEnd(
        normalized.length + ((4 - (normalized.length % 4 || 4)) % 4),
        "=",
      );
      const payload = JSON.parse(atob(padded)) as { user_id?: string };
      return payload.user_id || "";
    } catch {
      return "";
    }
  };

  const getCurrentUsername = () => {
    const cached = (localStorage.getItem("username") || "").trim();
    const token = localStorage.getItem("token");
    if (!token) return cached || "";

    const tokenUserId = decodeJwtUserId(token).trim();
    if (tokenUserId.length > 0) {
      if (cached !== tokenUserId) {
        localStorage.setItem("username", tokenUserId);
      }
      return tokenUserId;
    }

    return cached || "";
  };

  const postMessage = async (payload: { text?: string; imageKey?: string }) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const res = await fetch(`${BACKEND_API_BASE}/chat/messages`, {
      method: "POST",
      headers: {
        Authorization: auth,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    if (!res.ok) throw new Error(getText("sendFailed"));
  };

  const withdrawMessage = async (messageId: string) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const primary = await fetch(
      `${BACKEND_API_BASE}/chat/messages/${encodeURIComponent(messageId)}`,
      {
        method: "DELETE",
        headers: { Authorization: auth },
      },
    );
    if (primary.ok) return;

    const fallback = await fetch(
      `${BACKEND_API_BASE}/chat/messages/${encodeURIComponent(messageId)}/withdraw`,
      {
        method: "POST",
        headers: { Authorization: auth },
      },
    );
    if (!fallback.ok) throw new Error(getText("withdrawFailed"));
  };

  const canvasToWebpBlob = (canvas: HTMLCanvasElement, quality: number) =>
    new Promise<Blob | null>((resolve) => {
      canvas.toBlob(resolve, "image/webp", quality);
    });

  const loadImage = (file: File) =>
    new Promise<HTMLImageElement>((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => {
        URL.revokeObjectURL(url);
        resolve(image);
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error(getText("imageProcessFailed")));
      };
      image.src = url;
    });

  const compressImageToWebp = async (file: File) => {
    const image = await loadImage(file);
    const baseName = file.name.replace(/\.[^/.]+$/, "") || "chat-image";

    let quality = 0.9;
    let scale = 1;

    for (let index = 0; index < 18; index += 1) {
      const width = Math.max(1, Math.round(image.naturalWidth * scale));
      const height = Math.max(1, Math.round(image.naturalHeight * scale));

      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext("2d");
      if (!context) throw new Error(getText("imageProcessFailed"));
      context.drawImage(image, 0, 0, width, height);

      const blob = await canvasToWebpBlob(canvas, quality);
      if (blob && blob.size <= MAX_CHAT_IMAGE_BYTES) {
        return new File([blob], `${baseName}.webp`, {
          type: "image/webp",
          lastModified: Date.now(),
        });
      }

      if (quality > MIN_IMAGE_QUALITY) {
        quality = Math.max(MIN_IMAGE_QUALITY, quality - 0.1);
      } else {
        scale *= 0.84;
        quality = 0.86;
      }
    }

    throw new Error(getText("imageTooLarge"));
  };

  const uploadImage = async (file: File) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const compressedFile = await compressImageToWebp(file);
    if (compressedFile.size > MAX_CHAT_IMAGE_BYTES) {
      throw new Error(getText("imageTooLarge"));
    }

    const formData = new FormData();
    formData.append("image", compressedFile, compressedFile.name);

    const res = await fetch(`${BACKEND_API_BASE}/chat/images`, {
      method: "POST",
      headers: { Authorization: auth },
      body: formData,
    });

    if (!res.ok) throw new Error(getText("uploadFailed"));

    const data = (await res.json()) as { key: string };
    if (!data.key) throw new Error(getText("uploadFailed"));
    return data.key;
  };

  const setupEmojiPanel = (input: HTMLTextAreaElement) => {
    const panel = document.getElementById("chat-emoji-panel");
    const grid = document.getElementById("chat-emoji-grid");
    const qfaceGrid = document.getElementById("chat-qface-grid");
    const toggle = document.getElementById("chat-emoji-toggle");
    if (!panel || !grid || !qfaceGrid || !toggle) return;

    grid.innerHTML = EMOJI_PICKER.map(
      (emoji) =>
        `<button type="button" class="emoji-btn" data-emoji="${emoji}">${emoji}</button>`,
    ).join("");
    qfaceGrid.innerHTML = QFACE_PICKER.map(
      (qface) =>
        `<button type="button" class="qface-btn" data-qface="${qface}">[${qface}]</button>`,
    ).join("");

    const insertAtCursor = (value: string) => {
      const start = input.selectionStart;
      const end = input.selectionEnd;
      const text = input.value;
      input.value = `${text.slice(0, start)}${value}${text.slice(end)}`;
      const next = start + value.length;
      input.setSelectionRange(next, next);
      input.focus();
    };

    toggle.addEventListener("click", () => {
      panel.classList.toggle("hidden");
    });

    grid.querySelectorAll("[data-emoji]").forEach((button) => {
      button.addEventListener("click", () => {
        const emoji = button.getAttribute("data-emoji");
        if (!emoji) return;
        insertAtCursor(emoji);
      });
    });

    qfaceGrid.querySelectorAll("[data-qface]").forEach((button) => {
      button.addEventListener("click", () => {
        const qface = button.getAttribute("data-qface");
        if (!qface) return;
        insertAtCursor(`[[[qface:${qface}]]]`);
      });
    });

    return {
      insertAtCursor,
      openPanel: () => panel.classList.remove("hidden"),
    };
  };

  const setupChat = () => {
    const list = document.getElementById("chat-message-list");
    const input = document.getElementById(
      "chat-input",
    ) as HTMLTextAreaElement | null;
    const sendBtn = document.getElementById(
      "chat-send-btn",
    ) as HTMLButtonElement | null;
    const uploadBtn = document.getElementById(
      "chat-upload-btn",
    ) as HTMLButtonElement | null;
    const imageInput = document.getElementById(
      "chat-image-input",
    ) as HTMLInputElement | null;
    const replyBox = document.getElementById("reply-box");
    const replyAuthor = document.getElementById("reply-author");
    const replyPreview = document.getElementById("reply-preview");
    const replyCancelBtn = document.getElementById("reply-cancel-btn");
    const contextMenu = document.getElementById("chat-context-menu");
    if (
      !list ||
      !input ||
      !sendBtn ||
      !uploadBtn ||
      !imageInput ||
      !replyBox ||
      !replyAuthor ||
      !replyPreview ||
      !replyCancelBtn ||
      !contextMenu
    ) {
      return;
    }

    const emojiTools = setupEmojiPanel(input);
    if (!emojiTools) return;

    let replyingTo: MessageView | null = null;
    let currentMessages: MessageView[] = [];
    let avatarMap = new Map<string, string>();

    const closeContextMenu = () => {
      contextMenu.classList.add("hidden");
      contextMenu.innerHTML = "";
      contextMenu.removeAttribute("data-message-id");
      contextMenu.removeAttribute("data-own");
    };

    const writeClipboard = async (text: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error(getText("copyFailed"));
      }
      await navigator.clipboard.writeText(text);
    };

    const clearReply = () => {
      replyingTo = null;
      replyBox.classList.add("hidden");
    };

    const setReply = (messageId: string) => {
      const target = currentMessages.find((item) => item.id === messageId);
      if (!target) return;
      replyingTo = target;
      replyAuthor.textContent = `${getText("replying")} ${target.username}`;
      replyPreview.textContent = previewText(target.plainContent || "[image]");
      replyBox.classList.remove("hidden");
      input.focus();
    };

    replyCancelBtn.addEventListener("click", clearReply);

    const openContextMenu = (
      message: MessageView,
      isOwn: boolean,
      clientX: number,
      clientY: number,
    ) => {
      const actions = [
        { key: "reply", label: getText("menuReply"), danger: false },
        { key: "copy", label: getText("menuCopy"), danger: false },
        { key: "emoji", label: getText("menuEmoji"), danger: false },
        ...(isOwn
          ? [{ key: "withdraw", label: getText("menuWithdraw"), danger: true }]
          : []),
      ];

      const quickRow = QUICK_REACTIONS.map(
        (reaction) =>
          `<button type="button" class="context-reaction-chip" data-action="react" data-value="${escapeHtml(reaction.value)}">${escapeHtml(reaction.label)}</button>`,
      ).join("");

      contextMenu.innerHTML = `<div class="context-reaction-row">${quickRow}<button type="button" class="context-reaction-chip context-reaction-chip-more" data-action="more-emoji" title="${escapeHtml(getText("menuMoreEmoji"))}">⋯</button></div><div class="context-menu-divider"></div>${actions
        .map(
          (item) =>
            `<button type="button" class="context-menu-item${item.danger ? " context-menu-item-danger" : ""}" data-action="${item.key}">${escapeHtml(item.label)}</button>`,
        )
        .join("")}`;
      contextMenu.setAttribute("data-message-id", message.id);
      contextMenu.setAttribute("data-own", isOwn ? "1" : "0");
      contextMenu.style.left = `${clientX}px`;
      contextMenu.style.top = `${clientY}px`;
      contextMenu.classList.remove("hidden");

      const rect = contextMenu.getBoundingClientRect();
      const left = Math.max(
        8,
        Math.min(clientX, window.innerWidth - rect.width - 8),
      );
      const top = Math.max(
        8,
        Math.min(clientY, window.innerHeight - rect.height - 8),
      );
      contextMenu.style.left = `${left}px`;
      contextMenu.style.top = `${top}px`;
    };

    contextMenu.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement | null;
      const actionButton = target?.closest(
        "button[data-action]",
      ) as HTMLButtonElement | null;
      const action = actionButton?.getAttribute("data-action");
      if (!action) return;

      if (action === "react") {
        const value = actionButton?.getAttribute("data-value");
        if (!value) return;
        input.focus();
        emojiTools.insertAtCursor(value);
        closeContextMenu();
        return;
      }

      if (action === "more-emoji") {
        input.focus();
        emojiTools.openPanel();
        closeContextMenu();
        return;
      }

      const messageId = contextMenu.getAttribute("data-message-id") || "";
      const message = currentMessages.find((item) => item.id === messageId);
      closeContextMenu();
      if (!message) return;

      if (action === "reply") {
        setReply(message.id);
        return;
      }

      if (action === "copy") {
        try {
          const copyText =
            message.kind === "image" && message.imageKey
              ? `${BACKEND_API_BASE}/chat/images/${encodeURIComponent(message.imageKey)}`
              : message.plainContent;
          await writeClipboard(copyText);
        } catch (error) {
          alert(error instanceof Error ? error.message : getText("copyFailed"));
        }
        return;
      }

      if (action === "emoji") {
        input.focus();
        emojiTools.openPanel();
        emojiTools.insertAtCursor("[[[default:smile]]]");
        return;
      }

      if (action === "withdraw") {
        try {
          await withdrawMessage(message.id);
          if (replyingTo?.id === message.id) {
            clearReply();
          }
          await refreshFull(true);
        } catch (error) {
          alert(
            error instanceof Error ? error.message : getText("withdrawFailed"),
          );
        }
      }
    });

    list.addEventListener("contextmenu", (event) => {
      const target = event.target as HTMLElement | null;
      const row = target?.closest(".message-row") as HTMLElement | null;
      if (!row) {
        closeContextMenu();
        return;
      }

      const messageId = row.getAttribute("data-id") || "";
      const message = currentMessages.find((item) => item.id === messageId);
      if (!message) return;

      event.preventDefault();
      openContextMenu(
        message,
        row.classList.contains("message-row-own"),
        event.clientX,
        event.clientY,
      );
    });

    document.addEventListener("click", (event) => {
      if (!contextMenu.contains(event.target as Node)) {
        closeContextMenu();
      }
    });
    window.addEventListener("resize", closeContextMenu);
    list.addEventListener("scroll", closeContextMenu, { passive: true });
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeContextMenu();
      }
    });

    const render = (stickToBottom: boolean) => {
      closeContextMenu();
      const ownUsername = getCurrentUsername();
      const ownAvatar = localStorage.getItem("avatar") || "";
      const map = new Map(currentMessages.map((item) => [item.id, item]));

      list.innerHTML = currentMessages
        .map((message) => {
          const normalizedOwn = ownUsername.trim().toLowerCase();
          const normalizedMessage = message.username.trim().toLowerCase();
          const isOwn =
            normalizedOwn.length > 0 && normalizedOwn === normalizedMessage;
          const bubbleClass = isOwn
            ? "message-row message-row-own"
            : "message-row";
          const avatar = getAvatarByUser(
            message.username,
            ownUsername,
            ownAvatar,
            avatarMap,
          );
          const replyTarget = message.replyToId
            ? map.get(message.replyToId)
            : null;
          const replyBlock = replyTarget
            ? `<div class="reply-quote"><p>${escapeHtml(replyTarget.username)}</p><span>${escapeHtml(previewText(replyTarget.plainContent || "[image]"))}</span></div>`
            : "";

          return `<li class="${bubbleClass}" data-id="${escapeHtml(message.id)}"><img class="message-avatar" src="${avatar}" alt="${escapeHtml(message.username)}" loading="lazy"><div class="message-bubble"><div class="message-head"><span>${escapeHtml(message.username)}</span><time>${new Date(message.createdMs).toLocaleTimeString()}</time></div>${replyBlock}<div class="message-body">${renderContent(message)}</div><div class="message-foot"><button type="button" class="reply-btn" data-reply-id="${escapeHtml(message.id)}">${escapeHtml(getText("menuReply"))}</button></div></div></li>`;
        })
        .join("");

      list.querySelectorAll("[data-reply-id]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-reply-id");
          if (!id) return;
          setReply(id);
        });
      });

      if (stickToBottom) {
        list.scrollTop = list.scrollHeight;
      }
    };

    const refreshFull = async (forceStick = false) => {
      const stickToBottom = forceStick || isNearBottom(list);
      try {
        const [messages, users] = await Promise.all([
          fetchMessages(),
          fetchUsers(),
        ]);
        avatarMap = users;
        currentMessages = messages.map(parseMessage);
        render(stickToBottom);
        setStatus(getText("online"), true);
      } catch {
        setStatus(getText("offline"), false);
      }
    };

    const mergeMessages = (incoming: ChatMessage[]) => {
      if (incoming.length === 0) return;
      const stickToBottom = isNearBottom(list);
      const map = new Map(currentMessages.map((item) => [item.id, item]));
      incoming.forEach((message) => {
        map.set(message.id, parseMessage(message));
      });
      currentMessages = Array.from(map.values()).sort(
        (a, b) => a.createdMs - b.createdMs,
      );
      render(stickToBottom);
      setStatus(getText("online"), true);
    };

    const closeRealtime = () => {
      if (window._chatPanelEventSource) {
        window._chatPanelEventSource.close();
        window._chatPanelEventSource = null;
      }
      if (window._chatPanelPollTimer) {
        window.clearTimeout(window._chatPanelPollTimer);
        window._chatPanelPollTimer = null;
      }
    };

    const scheduleReconnect = () => {
      if (window._chatPanelPollTimer) {
        window.clearTimeout(window._chatPanelPollTimer);
      }
      window._chatPanelPollTimer = window.setTimeout(() => {
        void connectSse();
      }, SSE_RECONNECT_DELAY_MS);
    };

    const connectSse = async () => {
      closeRealtime();
      const since = currentMessages.length
        ? currentMessages[currentMessages.length - 1].createdMs
        : 0;
      const source = new EventSource(
        `${BACKEND_API_BASE}/chat/stream?since=${since}`,
      );
      window._chatPanelEventSource = source;

      source.addEventListener("ready", () => {
        setStatus(getText("online"), true);
      });

      source.addEventListener("messages", (event) => {
        try {
          const payload = JSON.parse((event as MessageEvent).data) as {
            messages?: ChatMessage[];
          };
          mergeMessages(payload.messages || []);
        } catch {
          setStatus(getText("offline"), false);
        }
      });

      source.onerror = () => {
        setStatus(getText("offline"), false);
        closeRealtime();
        scheduleReconnect();
      };
    };

    closeRealtime();
    setStatus(getText("connecting"), false);
    void refreshFull(true).then(() => connectSse());

    sendBtn.onclick = async () => {
      const rawText = input.value.trim();
      if (!rawText) return;

      const defaultText = sendBtn.dataset.defaultText || getText("send");
      sendBtn.disabled = true;
      sendBtn.textContent = getText("sending");

      try {
        const text = replyingTo
          ? `[[[reply:${replyingTo.id}]]]\n${rawText}`
          : rawText;
        await postMessage({ text });
        input.value = "";
        clearReply();
        await refreshFull(true);
      } catch (error) {
        alert(error instanceof Error ? error.message : getText("sendFailed"));
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = defaultText;
      }
    };

    input.onkeydown = (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendBtn.click();
      }
    };

    uploadBtn.onclick = () => {
      imageInput.click();
    };

    imageInput.onchange = async () => {
      const file = imageInput.files?.[0];
      if (!file) return;

      uploadBtn.disabled = true;
      try {
        const imageKey = await uploadImage(file);
        const text = replyingTo ? `[[[reply:${replyingTo.id}]]]` : undefined;
        await postMessage({ imageKey, text });
        clearReply();
        await refreshFull(true);
      } catch (error) {
        alert(error instanceof Error ? error.message : getText("uploadFailed"));
      } finally {
        uploadBtn.disabled = false;
        imageInput.value = "";
      }
    };
  };

  document.addEventListener("astro:page-load", setupChat);
  window.addEventListener("logout-success", () => {
    if (window._chatPanelEventSource) {
      window._chatPanelEventSource.close();
      window._chatPanelEventSource = null;
    }
    if (window._chatPanelPollTimer) {
      window.clearTimeout(window._chatPanelPollTimer);
      window._chatPanelPollTimer = null;
    }
  });
</script>

