---
import unknownEmojiUrl from "../../assets/emoji/unknown.svg?url";
import { getLangFromUrl, getTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const emojiModules = import.meta.glob("../../assets/emoji/*/*.png", {
  eager: true,
  import: "default",
}) as Record<string, string | { src?: string }>;

const decodeSafe = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const emojiAssetMap = Object.entries(emojiModules).reduce(
  (acc, [path, moduleValue]) => {
    const match = path.match(/\/emoji\/([^/]+)\/([^/]+)\.png$/i);
    if (!match) return acc;

    const url =
      typeof moduleValue === "string" ? moduleValue : moduleValue?.src || "";
    if (!url) return acc;

    const pack = decodeSafe(match[1]);
    const name = decodeSafe(match[2]);
    if (!pack || !name) return acc;
    if (!acc[pack]) acc[pack] = {};
    acc[pack][name] = url;
    return acc;
  },
  {} as Record<string, Record<string, string>>,
);
---

<section class="chat-shell">
  <span id="chat-status" class="chat-status chat-status-compact"
    >{t("chat.status.connecting")}</span
  >

  <ul id="chat-message-list" class="chat-message-list"></ul>

  <div id="reply-box" class="reply-box hidden">
    <div class="reply-content">
      <p id="reply-author" class="reply-author"></p>
      <p id="reply-preview" class="reply-preview"></p>
    </div>
    <button id="reply-cancel-btn" class="reply-cancel-btn" type="button">
      ×
    </button>
  </div>

  <div class="composer-row">
    <div
      id="chat-input"
      class="chat-input chat-input-editor"
      contenteditable="true"
      role="textbox"
      aria-multiline="true"
      data-placeholder={t("chat.placeholder")}
    ></div>

    <div class="composer-actions">
      <input id="chat-image-input" type="file" accept="image/*" class="hidden">
      <button id="chat-emoji-toggle" class="action-btn" type="button">
        😊
      </button>
      <button id="chat-upload-btn" class="action-btn" type="button">＋</button>
      <button
        id="chat-send-btn"
        class="send-btn"
        type="button"
        data-default-text={t("chat.send")}
      >
        {t("chat.send")}
      </button>
    </div>
  </div>

  <div id="chat-emoji-panel" class="emoji-panel hidden">
    <div class="emoji-grid" id="chat-emoji-grid"></div>
    <div class="qface-grid" id="chat-qface-grid"></div>
  </div>

  <div id="chat-context-menu" class="chat-context-menu hidden"></div>
</section>

<script is:inline define:vars={{ emojiAssetMap, unknownEmojiUrl }}>
  window._emojiAssets = emojiAssetMap;
  window._unknownEmojiUrl = unknownEmojiUrl;
</script>

<script>
  import { BACKEND_API_BASE } from "../../config/loginApiBaseUrl";

  const CHAT_LIMIT = 50;
  const SSE_RECONNECT_DELAY_MS = 2500;
  const MAX_CHAT_IMAGE_BYTES = 512 * 1024;
  const MIN_IMAGE_QUALITY = 0.42;
  const EMOJI_TOKEN_PATTERN =
    /^\[\[\[\s*([^:\]：]+)\s*[:：]\s*([^\]]+?)\s*\]\]\]$/u;
  const REPLY_PREFIX_PATTERN = /^\[\[\[reply:([^\]]+)\]\]\]\n?/;
  const REACTION_PREFIX_PATTERN = /^\[\[\[react:([^\]]+)\]\]\]\n?/;
  const EMOJI_PICKER = [
    "😀",
    "😆",
    "🥰",
    "🤔",
    "😭",
    "😎",
    "😡",
    "👍",
    "🙏",
    "🎉",
    "✨",
    "🔥",
  ];
  const QUICK_REACTIONS = [
    { value: "😀" },
    { value: "🥰" },
    { value: "👍" },
    { value: "[[[qface:微笑]]]" },
    { value: "[[[qface:疑问]]]" },
  ];
  let emojiAssets: Record<string, Record<string, string>> = {};
  let availableEmojiKeys = new Set<string>();
  let unknownEmoji = "";

  type ChatMessage = {
    id: string;
    username: string;
    kind: "text" | "image";
    content: string;
    imageKey: string | null;
    createdMs: number;
  };

  type UserAvatar = {
    name: string;
    id: string;
  };

  type MessageView = ChatMessage & {
    plainContent: string;
    replyToId: string | null;
    reactionToId: string | null;
    localPending?: boolean;
    localPreviewUrl?: string | null;
  };

  const isNearBottom = (el: HTMLElement) =>
    el.scrollHeight - el.scrollTop - el.clientHeight < 72;

  const getLanguage = () => document.documentElement.lang || "en";

  const getText = (key: string) => {
    const table: Record<string, Record<string, string>> = {
      en: {
        connecting: "Connecting",
        online: "Online",
        offline: "Offline",
        sending: "Sending...",
        uploadFailed: "Upload failed",
        sendFailed: "Message failed",
        needLogin: "Please login first",
        replying: "Replying to",
        menuReply: "Reply",
        menuCopy: "Copy",
        menuEmoji: "Paste emoji",
        menuMoreEmoji: "More",
        menuWithdraw: "Withdraw",
        copyFailed: "Copy failed",
        withdrawFailed: "Withdraw failed",
        imageTooLarge: "Image must be smaller than 512KiB",
        imageProcessFailed: "Image processing failed",
      },
      "zh-cn": {
        connecting: "连接中",
        online: "在线",
        offline: "离线",
        sending: "发送中...",
        uploadFailed: "上传失败",
        sendFailed: "发送失败",
        needLogin: "请先登录",
        replying: "回复",
        menuReply: "回复",
        menuCopy: "复制",
        menuEmoji: "贴表情",
        menuMoreEmoji: "更多",
        menuWithdraw: "撤回",
        copyFailed: "复制失败",
        withdrawFailed: "撤回失败",
        imageTooLarge: "图片需要小于 512KiB",
        imageProcessFailed: "图片处理失败",
      },
      "zh-hk": {
        connecting: "連線中",
        online: "在線",
        offline: "離線",
        sending: "發送中...",
        uploadFailed: "上傳失敗",
        sendFailed: "發送失敗",
        needLogin: "請先登入",
        replying: "回覆",
        menuReply: "回覆",
        menuCopy: "複製",
        menuEmoji: "貼表情",
        menuMoreEmoji: "更多",
        menuWithdraw: "撤回",
        copyFailed: "複製失敗",
        withdrawFailed: "撤回失敗",
        imageTooLarge: "圖片需要小於 512KiB",
        imageProcessFailed: "圖片處理失敗",
      },
      ja: {
        connecting: "接続中",
        online: "オンライン",
        offline: "オフライン",
        sending: "送信中...",
        uploadFailed: "アップロード失敗",
        sendFailed: "送信失敗",
        needLogin: "先にログインしてください",
        replying: "返信先",
        menuReply: "返信",
        menuCopy: "コピー",
        menuEmoji: "絵文字を貼る",
        menuMoreEmoji: "もっと",
        menuWithdraw: "取り消し",
        copyFailed: "コピー失敗",
        withdrawFailed: "取り消し失敗",
        imageTooLarge: "画像は 512KiB 未満にしてください",
        imageProcessFailed: "画像処理に失敗しました",
      },
    };

    const values = table[getLanguage()] || table.en;
    return values[key] || table.en[key] || key;
  };

  const escapeHtml = (value: string) =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  const previewText = (value: string) => {
    const text = value.replaceAll("\n", " ").trim();
    return text.length > 60 ? `${text.slice(0, 60)}...` : text;
  };

  const parseMessage = (message: ChatMessage): MessageView => {
    const reactionMatch = message.content.match(REACTION_PREFIX_PATTERN);
    if (reactionMatch) {
      return {
        ...message,
        plainContent: message.content.replace(REACTION_PREFIX_PATTERN, ""),
        replyToId: null,
        reactionToId: reactionMatch[1] || null,
      };
    }

    const replyMatch = message.content.match(REPLY_PREFIX_PATTERN);
    const replyToId = replyMatch?.[1] || null;
    const plainContent = replyMatch
      ? message.content.replace(REPLY_PREFIX_PATTERN, "")
      : message.content;
    return {
      ...message,
      plainContent,
      replyToId,
      reactionToId: null,
    };
  };

  const normalizePack = (value: string) => value.trim().toLowerCase();
  const normalizeEmojiName = (value: string) => value.trim().normalize("NFC");
  const getEmojiKey = (pack: string, name: string) =>
    `${normalizePack(pack)}:${normalizeEmojiName(name)}`;

  const hasEmoji = (pack: string, name: string) =>
    availableEmojiKeys.has(getEmojiKey(pack, name));

  const getEmojiImage = (pack: string, name: string) => {
    const normalizedPack = normalizePack(pack);
    const normalizedName = normalizeEmojiName(name);
    if (!hasEmoji(normalizedPack, normalizedName)) return "";
    return emojiAssets[normalizedPack]?.[normalizedName] || "";
  };

  const renderEmojiTokenImage = (
    pack: string,
    name: string,
    sizeClass = "",
  ) => {
    const src = getEmojiImage(pack, name) || unknownEmoji;
    if (!src) {
      return `<span class="emoji-token" title="${escapeHtml(`${pack}:${name}`)}">?</span>`;
    }
    return `<img class="qface-inline ${sizeClass}" src="${escapeHtml(src)}" alt="${escapeHtml(`[${name}]`)}" title="${escapeHtml(`${pack}:${name}`)}" loading="lazy">`;
  };

  const renderReactionValueHtml = (value: string) => {
    const tokenMatch = value.match(EMOJI_TOKEN_PATTERN);
    if (!tokenMatch) {
      return `<span>${escapeHtml(value)}</span>`;
    }

    const pack = tokenMatch[1].trim().toLowerCase();
    const name = tokenMatch[2].trim();
    return renderEmojiTokenImage(pack, name, "qface-inline-small");
  };

  const getAvatarByUser = (
    username: string,
    ownUsername: string,
    ownAvatar: string,
    avatarMap: Map<string, string>,
  ) => {
    if (username === ownUsername && /^[0-9a-f]{16}$/.test(ownAvatar)) {
      return `${BACKEND_API_BASE}/user/avatar/${ownAvatar}`;
    }
    const avatarId = avatarMap.get(username) || "";
    if (/^[0-9a-f]{16}$/.test(avatarId)) {
      return `${BACKEND_API_BASE}/user/avatar/${avatarId}`;
    }
    return `https://ui-avatars.com/api/?name=${encodeURIComponent(username)}&background=1f2937&color=ffffff&size=96`;
  };

  const renderContent = (message: MessageView) => {
    if (message.localPending && message.localPreviewUrl) {
      return `<div class="chat-image-wrap"><img class="chat-image chat-image-pending" src="${escapeHtml(message.localPreviewUrl)}" alt="uploading image" loading="lazy"><span class="chat-image-loading">⏳</span></div>`;
    }

    if (message.kind === "image" && message.imageKey) {
      const image = encodeURIComponent(message.imageKey);
      return `<img class="chat-image" src="${BACKEND_API_BASE}/chat/images/${image}" alt="chat image" loading="lazy">`;
    }

    const parts: string[] = [];
    const tokenRegex = /\[\[\[\s*([^:\]：]+)\s*[:：]\s*([^\]]+?)\s*\]\]\]/gu;
    let cursor = 0;

    for (const match of message.plainContent.matchAll(tokenRegex)) {
      const full = match[0] || "";
      const pack = (match[1] || "").trim().toLowerCase();
      const name = (match[2] || "").trim();
      const start = match.index ?? -1;
      if (start < 0) continue;

      const plainChunk = message.plainContent.slice(cursor, start);
      if (plainChunk) {
        parts.push(`<span>${escapeHtml(plainChunk)}</span>`);
      }

      parts.push(renderEmojiTokenImage(pack, name));

      cursor = start + full.length;
    }

    const tail = message.plainContent.slice(cursor);
    if (tail) {
      parts.push(`<span>${escapeHtml(tail)}</span>`);
    }

    return parts.length > 0
      ? parts.join("")
      : `<span>${escapeHtml(message.plainContent)}</span>`;
  };

  const setStatus = (text: string, online: boolean) => {
    const status = document.getElementById("chat-status");
    if (!status) return;
    status.textContent = text;
    status.classList.toggle("chat-status-online", online);
  };

  const fetchUsers = async () => {
    const res = await fetch(`${BACKEND_API_BASE}/users`, {
      cache: "no-store",
    });
    if (!res.ok) return new Map<string, string>();
    const users = (await res.json()) as UserAvatar[];
    return new Map<string, string>(users.map((item) => [item.name, item.id]));
  };

  const fetchMessages = async () => {
    const res = await fetch(
      `${BACKEND_API_BASE}/chat/messages?limit=${CHAT_LIMIT}`,
      {
        cache: "no-store",
      },
    );
    if (!res.ok) throw new Error("load failed");
    const data = (await res.json()) as { messages: ChatMessage[] };
    return data.messages || [];
  };

  const getAuthHeader = () => {
    const token = localStorage.getItem("token");
    return token ? `Bearer ${token}` : null;
  };

  const decodeJwtUserId = (token: string) => {
    try {
      const payloadPart = token.split(".")[1] || "";
      const normalized = payloadPart.replaceAll("-", "+").replaceAll("_", "/");
      const padded = normalized.padEnd(
        normalized.length + ((4 - (normalized.length % 4 || 4)) % 4),
        "=",
      );
      const payload = JSON.parse(atob(padded)) as { user_id?: string };
      return payload.user_id || "";
    } catch {
      return "";
    }
  };

  const getCurrentUsername = () => {
    const cached = (localStorage.getItem("username") || "").trim();
    const token = localStorage.getItem("token");
    if (!token) return cached || "";

    const tokenUserId = decodeJwtUserId(token).trim();
    if (tokenUserId.length > 0) {
      if (cached !== tokenUserId) {
        localStorage.setItem("username", tokenUserId);
      }
      return tokenUserId;
    }

    return cached || "";
  };

  const postMessage = async (payload: { text?: string; imageKey?: string }) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const res = await fetch(`${BACKEND_API_BASE}/chat/messages`, {
      method: "POST",
      headers: {
        Authorization: auth,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    if (!res.ok) throw new Error(getText("sendFailed"));
  };

  const withdrawMessage = async (messageId: string) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const primary = await fetch(
      `${BACKEND_API_BASE}/chat/messages/${encodeURIComponent(messageId)}`,
      {
        method: "DELETE",
        headers: { Authorization: auth },
      },
    );
    if (primary.ok) return;

    const fallback = await fetch(
      `${BACKEND_API_BASE}/chat/messages/${encodeURIComponent(messageId)}/withdraw`,
      {
        method: "POST",
        headers: { Authorization: auth },
      },
    );
    if (!fallback.ok) throw new Error(getText("withdrawFailed"));
  };

  const canvasToWebpBlob = (canvas: HTMLCanvasElement, quality: number) =>
    new Promise<Blob | null>((resolve) => {
      canvas.toBlob(resolve, "image/webp", quality);
    });

  const loadImage = (file: File) =>
    new Promise<HTMLImageElement>((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => {
        URL.revokeObjectURL(url);
        resolve(image);
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        reject(new Error(getText("imageProcessFailed")));
      };
      image.src = url;
    });

  const compressImageToWebp = async (file: File) => {
    const image = await loadImage(file);
    const baseName = file.name.replace(/\.[^/.]+$/, "") || "chat-image";

    let quality = 0.9;
    let scale = 1;

    for (let index = 0; index < 18; index += 1) {
      const width = Math.max(1, Math.round(image.naturalWidth * scale));
      const height = Math.max(1, Math.round(image.naturalHeight * scale));

      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const context = canvas.getContext("2d");
      if (!context) throw new Error(getText("imageProcessFailed"));
      context.drawImage(image, 0, 0, width, height);

      const blob = await canvasToWebpBlob(canvas, quality);
      if (blob && blob.size <= MAX_CHAT_IMAGE_BYTES) {
        return new File([blob], `${baseName}.webp`, {
          type: "image/webp",
          lastModified: Date.now(),
        });
      }

      if (quality > MIN_IMAGE_QUALITY) {
        quality = Math.max(MIN_IMAGE_QUALITY, quality - 0.1);
      } else {
        scale *= 0.84;
        quality = 0.86;
      }
    }

    throw new Error(getText("imageTooLarge"));
  };

  const uploadImage = async (file: File) => {
    const auth = getAuthHeader();
    if (!auth) throw new Error(getText("needLogin"));

    const compressedFile = await compressImageToWebp(file);
    if (compressedFile.size > MAX_CHAT_IMAGE_BYTES) {
      throw new Error(getText("imageTooLarge"));
    }

    const formData = new FormData();
    formData.append("image", compressedFile, compressedFile.name);

    const res = await fetch(`${BACKEND_API_BASE}/chat/images`, {
      method: "POST",
      headers: { Authorization: auth },
      body: formData,
    });

    if (!res.ok) throw new Error(getText("uploadFailed"));

    const data = (await res.json()) as { key: string };
    if (!data.key) throw new Error(getText("uploadFailed"));
    return data.key;
  };

  const getEditorText = (editor: HTMLElement): string => {
    const walk = (node: Node): string => {
      if (node.nodeType === Node.TEXT_NODE) {
        return node.textContent || "";
      }

      if (node.nodeType !== Node.ELEMENT_NODE) {
        return "";
      }

      const element = node as HTMLElement;
      if (element.tagName === "IMG" && element.dataset.token) {
        return element.dataset.token;
      }
      if (element.tagName === "BR") {
        return "\n";
      }

      let text = "";
      element.childNodes.forEach((child) => {
        text += walk(child);
      });

      if (
        (element.tagName === "DIV" || element.tagName === "P") &&
        !text.endsWith("\n")
      ) {
        text += "\n";
      }

      return text;
    };

    return walk(editor)
      .replaceAll(/\n{3,}/g, "\n\n")
      .trimEnd();
  };

  const insertNodeAtCursor = (node: Node, editor: HTMLElement) => {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0) {
      (editor as unknown as ParentNode).appendChild(node as ChildNode);
      return;
    }
    const range = selection.getRangeAt(0);
    range.deleteContents();
    range.insertNode(node);
    range.setStartAfter(node);
    range.collapse(true);
    selection.removeAllRanges();
    selection.addRange(range);
  };

  const setupEmojiPanel = (
    input: HTMLElement,
    onPickToken?: (value: string) => boolean | Promise<boolean>,
    onTogglePanel?: () => void,
  ) => {
    const panel = document.getElementById("chat-emoji-panel");
    const grid = document.getElementById("chat-emoji-grid");
    const qfaceGrid = document.getElementById("chat-qface-grid");
    const toggle = document.getElementById("chat-emoji-toggle");
    if (!panel || !grid || !qfaceGrid || !toggle) return;
    const qfacePicker = Object.keys(emojiAssets.qface || {}).sort((a, b) =>
      a.localeCompare(b, "zh-Hans-CN-u-co-pinyin"),
    );

    grid.innerHTML = EMOJI_PICKER.map(
      (emoji) =>
        `<button type="button" class="emoji-btn" data-emoji="${emoji}">${emoji}</button>`,
    ).join("");
    qfaceGrid.innerHTML = qfacePicker
      .map((qface) => {
        const src = getEmojiImage("qface", qface) || unknownEmoji;
        return `<button type="button" class="qface-btn" data-qface="${escapeHtml(qface)}"><img class="qface-picker-img" src="${escapeHtml(src)}" alt="${escapeHtml(`[${qface}]`)}" loading="lazy"></button>`;
      })
      .join("");

    const insertAtCursor = (value: string) => {
      input.focus();
      const match = value.match(EMOJI_TOKEN_PATTERN);
      if (match) {
        const pack = match[1].trim().toLowerCase();
        const emojiName = match[2].trim();
        const src = getEmojiImage(pack, emojiName) || unknownEmoji;
        if (src) {
          const image = document.createElement("img");
          image.className = "qface-inline qface-inline-editor";
          image.src = src;
          image.alt = `[${emojiName}]`;
          image.dataset.token = `[[[${pack}:${emojiName}]]]`;
          image.setAttribute("loading", "lazy");
          image.setAttribute("contenteditable", "false");
          insertNodeAtCursor(image, input);
          insertNodeAtCursor(document.createTextNode(" "), input);
          return;
        }
      }

      insertNodeAtCursor(document.createTextNode(value), input);
    };

    toggle.addEventListener("click", () => {
      onTogglePanel?.();
      panel.classList.toggle("hidden");
    });

    const applyToken = async (value: string) => {
      const consumed = onPickToken ? await onPickToken(value) : false;
      if (!consumed) {
        insertAtCursor(value);
      }
    };

    grid.querySelectorAll("[data-emoji]").forEach((button) => {
      button.addEventListener("click", () => {
        const emoji = button.getAttribute("data-emoji");
        if (!emoji) return;
        void applyToken(emoji);
      });
    });

    qfaceGrid.querySelectorAll("[data-qface]").forEach((button) => {
      button.addEventListener("click", () => {
        const qface = button.getAttribute("data-qface");
        if (!qface) return;
        void applyToken(`[[[qface:${qface}]]]`);
      });
    });

    return {
      insertAtCursor,
      openPanel: () => panel.classList.remove("hidden"),
      closePanel: () => panel.classList.add("hidden"),
    };
  };

  const setupChat = () => {
    const scopedWindow = window as Window & {
      _emojiAssets?: Record<string, Record<string, string>>;
      _unknownEmojiUrl?: string;
    };

    emojiAssets = Object.entries(scopedWindow._emojiAssets || {}).reduce(
      (acc, [pack, entries]) => {
        const normalizedPack = normalizePack(pack);
        if (!acc[normalizedPack]) acc[normalizedPack] = {};
        Object.entries(entries || {}).forEach(([name, url]) => {
          const normalizedName = normalizeEmojiName(name);
          acc[normalizedPack][normalizedName] = url;
        });
        return acc;
      },
      {} as Record<string, Record<string, string>>,
    );

    availableEmojiKeys = new Set(
      Object.entries(emojiAssets).flatMap(([pack, entries]) =>
        Object.keys(entries).map((name) => getEmojiKey(pack, name)),
      ),
    );
    unknownEmoji = scopedWindow._unknownEmojiUrl || "";

    const list = document.getElementById("chat-message-list");
    const input = document.getElementById("chat-input") as HTMLElement | null;
    const sendBtn = document.getElementById(
      "chat-send-btn",
    ) as HTMLButtonElement | null;
    const uploadBtn = document.getElementById(
      "chat-upload-btn",
    ) as HTMLButtonElement | null;
    const imageInput = document.getElementById(
      "chat-image-input",
    ) as HTMLInputElement | null;
    const replyBox = document.getElementById("reply-box");
    const replyAuthor = document.getElementById("reply-author");
    const replyPreview = document.getElementById("reply-preview");
    const replyCancelBtn = document.getElementById("reply-cancel-btn");
    const contextMenu = document.getElementById("chat-context-menu");
    if (
      !list ||
      !input ||
      !sendBtn ||
      !uploadBtn ||
      !imageInput ||
      !replyBox ||
      !replyAuthor ||
      !replyPreview ||
      !replyCancelBtn ||
      !contextMenu
    ) {
      return;
    }

    let replyingTo: MessageView | null = null;
    let currentMessages: MessageView[] = [];
    let avatarMap = new Map<string, string>();
    let pendingReactionToId: string | null = null;
    let localSeq = 0;
    const pendingReactionKeys = new Set<string>();
    const pendingWithdrawIds = new Set<string>();

    const normalizeUserKey = (value: string) => value.trim().toLowerCase();

    const createLocalId = (prefix: string) => {
      localSeq += 1;
      return `${prefix}-${Date.now()}-${localSeq}`;
    };

    const upsertMessage = (message: MessageView) => {
      const index = currentMessages.findIndex((item) => item.id === message.id);
      if (index >= 0) {
        currentMessages[index] = message;
      } else {
        currentMessages.push(message);
      }
      currentMessages.sort((a, b) => a.createdMs - b.createdMs);
    };

    const removeMessageById = (id: string) => {
      currentMessages = currentMessages.filter((item) => item.id !== id);
    };

    const sendReaction = async (messageId: string, value: string) => {
      const token = value.trim();
      if (!token) return;

      const pendingKey = `${messageId}::${token}`;
      if (pendingReactionKeys.has(pendingKey)) return;
      pendingReactionKeys.add(pendingKey);

      const ownUser = normalizeUserKey(getCurrentUsername());
      const ownSameTokenReactions = currentMessages
        .filter(
          (item) =>
            item.reactionToId === messageId &&
            normalizeUserKey(item.username) === ownUser &&
            item.plainContent.trim() === token,
        )
        .sort((a, b) => a.createdMs - b.createdMs);

      const hadSameToken = ownSameTokenReactions.length > 0;

      ownSameTokenReactions.forEach((reaction) => {
        removeMessageById(reaction.id);
      });
      render(false);

      try {
        for (const reaction of ownSameTokenReactions) {
          if (!reaction.localPending) {
            await withdrawMessage(reaction.id);
          }
        }

        if (hadSameToken) {
          await refreshFull(false);
          return;
        }

        const ownUsername = getCurrentUsername();
        const tempReaction: MessageView = {
          id: createLocalId("local-reaction"),
          username: ownUsername,
          kind: "text",
          content: `[[[react:${messageId}]]]\n${token}`,
          imageKey: null,
          createdMs: Date.now(),
          plainContent: token,
          replyToId: null,
          reactionToId: messageId,
          localPending: true,
        };
        upsertMessage(tempReaction);
        render(false);

        const reactionText = `[[[react:${messageId}]]]\n${token}`;
        await postMessage({ text: reactionText });
        await refreshFull(false);
      } finally {
        pendingReactionKeys.delete(pendingKey);
        render(false);
      }
    };

    const emojiTools = setupEmojiPanel(
      input,
      async (value) => {
        if (!pendingReactionToId) {
          return false;
        }
        const targetId = pendingReactionToId;
        pendingReactionToId = null;
        emojiTools?.closePanel();
        try {
          await sendReaction(targetId, value);
        } catch (error) {
          alert(error instanceof Error ? error.message : getText("sendFailed"));
        }
        return true;
      },
      () => {
        pendingReactionToId = null;
      },
    );
    if (!emojiTools) return;

    const closeContextMenu = () => {
      contextMenu.classList.add("hidden");
      contextMenu.innerHTML = "";
      contextMenu.removeAttribute("data-message-id");
      contextMenu.removeAttribute("data-own");
    };

    const writeClipboard = async (text: string) => {
      if (!navigator.clipboard?.writeText) {
        throw new Error(getText("copyFailed"));
      }
      await navigator.clipboard.writeText(text);
    };

    const clearReply = () => {
      replyingTo = null;
      replyBox.classList.add("hidden");
    };

    const setReply = (messageId: string) => {
      const target = currentMessages.find((item) => item.id === messageId);
      if (!target) return;
      replyingTo = target;
      replyAuthor.textContent = `${getText("replying")} ${target.username}`;
      replyPreview.textContent = previewText(target.plainContent || "[image]");
      replyBox.classList.remove("hidden");
      input.focus();
    };

    replyCancelBtn.addEventListener("click", clearReply);

    const openContextMenu = (
      message: MessageView,
      isOwn: boolean,
      clientX: number,
      clientY: number,
    ) => {
      const actions = [
        { key: "reply", label: getText("menuReply"), danger: false },
        { key: "copy", label: getText("menuCopy"), danger: false },
        { key: "emoji", label: getText("menuEmoji"), danger: false },
        ...(isOwn
          ? [{ key: "withdraw", label: getText("menuWithdraw"), danger: true }]
          : []),
      ];

      const quickRow = QUICK_REACTIONS.map((reaction) => {
        const labelHtml = renderReactionValueHtml(reaction.value);
        return `<button type="button" class="context-reaction-chip" data-action="react" data-value="${escapeHtml(reaction.value)}">${labelHtml}</button>`;
      }).join("");

      contextMenu.innerHTML = `<div class="context-reaction-row">${quickRow}<button type="button" class="context-reaction-chip context-reaction-chip-more" data-action="more-emoji" title="${escapeHtml(getText("menuMoreEmoji"))}">⋯</button></div><div class="context-menu-divider"></div>${actions
        .map(
          (item) =>
            `<button type="button" class="context-menu-item${item.danger ? " context-menu-item-danger" : ""}" data-action="${item.key}">${escapeHtml(item.label)}</button>`,
        )
        .join("")}`;
      contextMenu.setAttribute("data-message-id", message.id);
      contextMenu.setAttribute("data-own", isOwn ? "1" : "0");
      contextMenu.style.left = `${clientX}px`;
      contextMenu.style.top = `${clientY}px`;
      contextMenu.classList.remove("hidden");

      const rect = contextMenu.getBoundingClientRect();
      const left = Math.max(
        8,
        Math.min(clientX, window.innerWidth - rect.width - 8),
      );
      const top = Math.max(
        8,
        Math.min(clientY, window.innerHeight - rect.height - 8),
      );
      contextMenu.style.left = `${left}px`;
      contextMenu.style.top = `${top}px`;
    };

    contextMenu.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement | null;
      const actionButton = target?.closest(
        "button[data-action]",
      ) as HTMLButtonElement | null;
      const action = actionButton?.getAttribute("data-action");
      if (!action) return;

      const messageId = contextMenu.getAttribute("data-message-id") || "";

      if (action === "react") {
        const value = actionButton?.getAttribute("data-value");
        if (!value || !messageId) return;
        try {
          await sendReaction(messageId, value);
        } catch (error) {
          alert(error instanceof Error ? error.message : getText("sendFailed"));
        }
        closeContextMenu();
        return;
      }

      if (action === "more-emoji") {
        if (!messageId) return;
        pendingReactionToId = messageId;
        emojiTools.openPanel();
        closeContextMenu();
        return;
      }

      const message = currentMessages.find((item) => item.id === messageId);
      closeContextMenu();
      if (!message) return;

      if (action === "reply") {
        setReply(message.id);
        return;
      }

      if (action === "copy") {
        try {
          const copyText =
            message.kind === "image" && message.imageKey
              ? `${BACKEND_API_BASE}/chat/images/${encodeURIComponent(message.imageKey)}`
              : message.plainContent;
          await writeClipboard(copyText);
        } catch (error) {
          alert(error instanceof Error ? error.message : getText("copyFailed"));
        }
        return;
      }

      if (action === "emoji") {
        pendingReactionToId = message.id;
        emojiTools.openPanel();
        return;
      }

      if (action === "withdraw") {
        try {
          pendingWithdrawIds.add(message.id);
          render(false);
          await withdrawMessage(message.id);
          pendingWithdrawIds.delete(message.id);
          removeMessageById(message.id);
          render(false);
          if (replyingTo?.id === message.id) {
            clearReply();
          }
          void refreshFull(false);
        } catch (error) {
          pendingWithdrawIds.delete(message.id);
          render(false);
          alert(
            error instanceof Error ? error.message : getText("withdrawFailed"),
          );
        }
      }
    });

    list.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement | null;
      const reactionButton = target?.closest(
        "button[data-reaction-message-id][data-reaction-token]",
      ) as HTMLButtonElement | null;
      if (!reactionButton) return;

      const messageId = reactionButton.getAttribute("data-reaction-message-id");
      const encodedToken = reactionButton.getAttribute("data-reaction-token");
      const ownReacted =
        reactionButton.getAttribute("data-own-reacted") === "1";
      if (!messageId || !encodedToken || !ownReacted) return;

      try {
        await sendReaction(messageId, decodeURIComponent(encodedToken));
      } catch (error) {
        alert(error instanceof Error ? error.message : getText("sendFailed"));
      }
    });

    list.addEventListener("contextmenu", (event) => {
      const target = event.target as HTMLElement | null;
      const row = target?.closest(".message-row") as HTMLElement | null;
      if (!row) {
        closeContextMenu();
        return;
      }

      const messageId = row.getAttribute("data-id") || "";
      const message = currentMessages.find((item) => item.id === messageId);
      if (!message) return;

      event.preventDefault();
      openContextMenu(
        message,
        row.classList.contains("message-row-own"),
        event.clientX,
        event.clientY,
      );
    });

    document.addEventListener("click", (event) => {
      if (!contextMenu.contains(event.target as Node)) {
        closeContextMenu();
      }
    });
    window.addEventListener("resize", closeContextMenu);
    list.addEventListener("scroll", closeContextMenu, { passive: true });
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeContextMenu();
      }
    });

    const render = (stickToBottom: boolean) => {
      closeContextMenu();
      const ownUsername = getCurrentUsername();
      const ownAvatar = localStorage.getItem("avatar") || "";
      const map = new Map(currentMessages.map((item) => [item.id, item]));
      const visibleMessages = currentMessages.filter(
        (item) => !item.reactionToId,
      );
      const ownUser = normalizeUserKey(ownUsername);
      const latestReactionByUser = new Map<string, MessageView>();
      const reactionBuckets = new Map<
        string,
        Map<
          string,
          {
            count: number;
            ownReactionId: string | null;
            users: Array<{ username: string; avatar: string; own: boolean }>;
          }
        >
      >();

      currentMessages
        .filter((item): item is MessageView => Boolean(item.reactionToId))
        .sort((a, b) => a.createdMs - b.createdMs)
        .forEach((reaction) => {
          const key = `${reaction.reactionToId}::${normalizeUserKey(reaction.username)}::${reaction.plainContent.trim()}`;
          latestReactionByUser.set(key, reaction);
        });

      latestReactionByUser.forEach((reaction) => {
        if (!reaction.reactionToId) return;
        const token = reaction.plainContent.trim();
        if (!token) return;

        if (!reactionBuckets.has(reaction.reactionToId)) {
          reactionBuckets.set(reaction.reactionToId, new Map());
        }
        const tokenMap = reactionBuckets.get(reaction.reactionToId);
        if (!tokenMap) return;

        const userOwn = normalizeUserKey(reaction.username) === ownUser;
        const avatar = getAvatarByUser(
          reaction.username,
          ownUsername,
          ownAvatar,
          avatarMap,
        );
        const bucket = tokenMap.get(token) || {
          count: 0,
          ownReactionId: null,
          users: [],
        };
        bucket.count += 1;
        if (userOwn) {
          bucket.ownReactionId = reaction.id;
        }
        bucket.users.push({
          username: reaction.username,
          avatar,
          own: userOwn,
        });
        tokenMap.set(token, bucket);
      });

      list.innerHTML = visibleMessages
        .map((message) => {
          const normalizedOwn = ownUsername.trim().toLowerCase();
          const normalizedMessage = message.username.trim().toLowerCase();
          const isOwn =
            normalizedOwn.length > 0 && normalizedOwn === normalizedMessage;
          const bubbleClass = `${isOwn ? "message-row message-row-own" : "message-row"}${pendingWithdrawIds.has(message.id) ? " message-row-withdrawing" : ""}`;
          const avatar = getAvatarByUser(
            message.username,
            ownUsername,
            ownAvatar,
            avatarMap,
          );
          const replyTarget = message.replyToId
            ? map.get(message.replyToId)
            : null;
          const replyBlock = replyTarget
            ? `<div class="reply-quote"><p>${escapeHtml(replyTarget.username)}</p><span>${escapeHtml(previewText(replyTarget.plainContent || "[image]"))}</span></div>`
            : "";
          const reactions = reactionBuckets.get(message.id);
          const reactionBlock = reactions
            ? `<div class="message-reactions">${Array.from(reactions.entries())
                .map(
                  ([token, info]) =>
                    `<button type="button" class="reaction-pill${info.ownReactionId ? " reaction-pill-own" : ""}${pendingReactionKeys.has(`${message.id}::${token}`) ? " reaction-pill-loading" : ""}" data-reaction-message-id="${escapeHtml(message.id)}" data-reaction-token="${escapeHtml(encodeURIComponent(token))}" data-own-reacted="${info.ownReactionId ? "1" : "0"}">${renderReactionValueHtml(token)} <span class="reaction-count">${info.count}</span><span class="reaction-avatars">${info.users
                      .slice(0, 3)
                      .map(
                        (user) =>
                          `<img class="reaction-avatar${user.own ? " reaction-avatar-own" : ""}" src="${escapeHtml(user.avatar)}" alt="${escapeHtml(user.username)}" loading="lazy">`,
                      )
                      .join(
                        "",
                      )}${info.users.length > 3 ? `<span class="reaction-more">+${info.users.length - 3}</span>` : ""}</span></button>`,
                )
                .join("")}</div>`
            : "";

          return `<li class="${bubbleClass}" data-id="${escapeHtml(message.id)}"><img class="message-avatar" src="${avatar}" alt="${escapeHtml(message.username)}" loading="lazy"><div class="message-bubble"><div class="message-head"><span>${escapeHtml(message.username)}</span><time>${new Date(message.createdMs).toLocaleTimeString()}</time></div>${replyBlock}<div class="message-body">${renderContent(message)}</div>${reactionBlock}<div class="message-foot"><button type="button" class="reply-btn" data-reply-id="${escapeHtml(message.id)}">${escapeHtml(getText("menuReply"))}</button></div></div></li>`;
        })
        .join("");

      list.querySelectorAll("[data-reply-id]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-reply-id");
          if (!id) return;
          setReply(id);
        });
      });

      if (stickToBottom) {
        list.scrollTop = list.scrollHeight;
      }
    };

    const refreshFull = async (forceStick = false) => {
      const stickToBottom = forceStick || isNearBottom(list);
      try {
        const [messages, users] = await Promise.all([
          fetchMessages(),
          fetchUsers(),
        ]);
        avatarMap = users;
        currentMessages = messages.map(parseMessage);
        render(stickToBottom);
        setStatus(getText("online"), true);
      } catch {
        setStatus(getText("offline"), false);
      }
    };

    const mergeMessages = (incoming: ChatMessage[]) => {
      if (incoming.length === 0) return;
      const stickToBottom = isNearBottom(list);
      const map = new Map(currentMessages.map((item) => [item.id, item]));
      incoming.forEach((message) => {
        map.set(message.id, parseMessage(message));
      });
      currentMessages = Array.from(map.values()).sort(
        (a, b) => a.createdMs - b.createdMs,
      );
      render(stickToBottom);
      setStatus(getText("online"), true);
    };

    const closeRealtime = () => {
      if (window._chatPanelEventSource) {
        window._chatPanelEventSource.close();
        window._chatPanelEventSource = null;
      }
      if (window._chatPanelPollTimer) {
        window.clearTimeout(window._chatPanelPollTimer);
        window._chatPanelPollTimer = null;
      }
    };

    const scheduleReconnect = () => {
      if (window._chatPanelPollTimer) {
        window.clearTimeout(window._chatPanelPollTimer);
      }
      window._chatPanelPollTimer = window.setTimeout(() => {
        void connectSse();
      }, SSE_RECONNECT_DELAY_MS);
    };

    const connectSse = async () => {
      closeRealtime();
      const since = currentMessages.length
        ? currentMessages[currentMessages.length - 1].createdMs
        : 0;
      const source = new EventSource(
        `${BACKEND_API_BASE}/chat/stream?since=${since}`,
      );
      window._chatPanelEventSource = source;

      source.addEventListener("ready", () => {
        setStatus(getText("online"), true);
      });

      source.addEventListener("messages", (event) => {
        try {
          const payload = JSON.parse((event as MessageEvent).data) as {
            messages?: ChatMessage[];
          };
          mergeMessages(payload.messages || []);
        } catch {
          setStatus(getText("offline"), false);
        }
      });

      source.onerror = () => {
        setStatus(getText("offline"), false);
        closeRealtime();
        scheduleReconnect();
      };
    };

    closeRealtime();
    setStatus(getText("connecting"), false);
    void refreshFull(true).then(() => connectSse());

    sendBtn.onclick = async () => {
      pendingReactionToId = null;
      const rawText = getEditorText(input).trim();
      if (!rawText) return;

      const defaultText = sendBtn.dataset.defaultText || getText("send");
      sendBtn.disabled = true;
      sendBtn.textContent = getText("sending");

      try {
        const text = replyingTo
          ? `[[[reply:${replyingTo.id}]]]\n${rawText}`
          : rawText;
        await postMessage({ text });
        input.innerHTML = "";
        clearReply();
        await refreshFull(true);
      } catch (error) {
        alert(error instanceof Error ? error.message : getText("sendFailed"));
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = defaultText;
      }
    };

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendBtn.click();
      }
    });

    uploadBtn.onclick = () => {
      pendingReactionToId = null;
      imageInput.click();
    };

    imageInput.onchange = async () => {
      const file = imageInput.files?.[0];
      if (!file) return;

      uploadBtn.disabled = true;
      uploadBtn.classList.add("action-btn-loading");
      const ownUsername = getCurrentUsername();
      const previewUrl = URL.createObjectURL(file);
      const pendingImageId = createLocalId("local-image");
      const pendingImageMessage: MessageView = {
        id: pendingImageId,
        username: ownUsername,
        kind: "image",
        content: "",
        imageKey: null,
        createdMs: Date.now(),
        plainContent: "",
        replyToId: replyingTo?.id || null,
        reactionToId: null,
        localPending: true,
        localPreviewUrl: previewUrl,
      };
      upsertMessage(pendingImageMessage);
      render(true);

      try {
        const imageKey = await uploadImage(file);
        const text = replyingTo ? `[[[reply:${replyingTo.id}]]]` : undefined;
        await postMessage({ imageKey, text });
        clearReply();
        removeMessageById(pendingImageId);
        URL.revokeObjectURL(previewUrl);
        await refreshFull(true);
      } catch (error) {
        removeMessageById(pendingImageId);
        URL.revokeObjectURL(previewUrl);
        render(false);
        alert(error instanceof Error ? error.message : getText("uploadFailed"));
      } finally {
        uploadBtn.disabled = false;
        uploadBtn.classList.remove("action-btn-loading");
        imageInput.value = "";
      }
    };
  };

  document.addEventListener("astro:page-load", setupChat);
  window.addEventListener("logout-success", () => {
    if (window._chatPanelEventSource) {
      window._chatPanelEventSource.close();
      window._chatPanelEventSource = null;
    }
    if (window._chatPanelPollTimer) {
      window.clearTimeout(window._chatPanelPollTimer);
      window._chatPanelPollTimer = null;
    }
  });
</script>

<style>
  .chat-shell {
    height: 100%;
    min-height: 0;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(
      180deg,
      rgba(16, 19, 30, 0.7),
      rgba(11, 15, 25, 0.9)
    );
    display: grid;
    grid-template-rows: auto 1fr auto auto auto;
    gap: 0.5rem;
    padding: 0.75rem;
  }

  .chat-status {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.58);
  }

  .chat-status-compact {
    justify-self: end;
    padding: 0 0.2rem;
  }

  .chat-status-online {
    color: #a4ecb6;
  }

  .chat-message-list {
    margin: 0;
    padding: 0.2rem;
    list-style: none;
    overflow-y: auto;
    min-height: 0;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  :global(.message-row) {
    display: flex;
    width: 100%;
    max-width: 100%;
    align-items: flex-end;
    gap: 0.45rem;
    justify-content: flex-start;
  }

  :global(.message-row-withdrawing) {
    opacity: 0.45;
    transform: translateX(8px) scale(0.98);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }

  :global(.message-row-own) {
    justify-content: flex-start;
    flex-direction: row-reverse;
  }

  :global(.message-avatar) {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.2);
    flex: 0 0 auto;
  }

  :global(.message-bubble) {
    max-width: min(74%, 560px);
    border-radius: 14px 14px 14px 5px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    padding: 0.45rem 0.58rem;
    text-align: left;
  }

  :global(.message-row-own .message-bubble) {
    border-radius: 14px 14px 5px 14px;
    border-color: rgba(129, 215, 175, 0.42);
    background: rgba(122, 208, 167, 0.24);
  }

  :global(.message-head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 0.2rem;
  }

  :global(.message-body) {
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.92rem;
    word-break: break-word;
  }

  :global(.message-foot) {
    margin-top: 0.28rem;
    display: flex;
    justify-content: flex-end;
  }

  :global(.message-reactions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    margin-top: 0.36rem;
  }

  :global(.reaction-pill) {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.93);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    padding: 0.12rem 0.36rem 0.12rem 0.3rem;
    line-height: 1.3;
    cursor: pointer;
  }

  :global(.reaction-pill-own) {
    border-color: rgba(126, 217, 173, 0.48);
    background: rgba(126, 217, 173, 0.24);
  }

  :global(.reaction-pill-loading) {
    opacity: 0.65;
    pointer-events: none;
  }

  :global(.reaction-count) {
    font-weight: 600;
    min-width: 0.65rem;
    text-align: center;
  }

  :global(.reaction-avatars) {
    display: inline-flex;
    align-items: center;
    margin-left: 0.1rem;
  }

  :global(.reaction-avatar) {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(11, 15, 25, 0.8);
    margin-left: -0.24rem;
    background: rgba(0, 0, 0, 0.22);
  }

  :global(.reaction-avatar:first-child) {
    margin-left: 0;
  }

